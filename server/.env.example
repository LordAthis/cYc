# Verzio: v0.4.1 - 2026-10-19
# cYc szerver beallitasai. Masold le .env neven, es toltsd ki. A .env SOHA ne keruljon a gitbe!

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# A nyilvanos cim, PONTOSAN ugy, ahogy a bongeszo cimsoraban latszik. Perjel nelkul!
#   IP-cimes eleres (domain nelkul):  APP_ORIGIN=http://203.0.113.10
#   Kesobb domainnel es HTTPS-sel:    APP_ORIGIN=https://cyc.example.hu
# A suti "Secure" jelzoje es a HTTPS-fejlecek ebbol automatikusan allnak be (http -> ki, https -> be).
# FIGYELEM: http (IP-cim) eseten a Google bejelentkezes NEM mukodik, es a captcha szolgaltatok
# is domaint kernek - ilyenkor CAPTCHA_PROVIDER=none es GOOGLE_CLIENT_ID ures legyen.
APP_ORIGIN=http://203.0.113.10
# Nginx mogott 1
TRUST_PROXY=1

# Legalabb 32 karakteres veletlen titok. Generalas:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# FIGYELEM: ha kesobb megvaltoztatod, a bekapcsolt 2FA-k ervenytelenne valnak!
APP_SECRET=

DB_FILE=./data/cyc.sqlite
SESSION_DAYS=30

REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_MIN_LENGTH=10

# Captcha: turnstile | recaptcha | hcaptcha | none
#   Turnstile (ajanlott, ingyenes): https://dash.cloudflare.com -> Turnstile -> Add site
#   reCAPTCHA v2 ("Nem vagyok robot"): https://www.google.com/recaptcha/admin
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Google bejelentkezes: https://console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
#   Authorized JavaScript origins: a fenti APP_ORIGIN (es fejleszteshez http://localhost:3000)
# Uresen hagyva a Google gomb nem jelenik meg.
GOOGLE_CLIENT_ID=

# E-mail kuldes (SMTP). Uresen hagyva a levelek a szerver konzoljara kerulnek (csak fejleszteshez!)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="cYc <no-reply@cyc.example.hu>"
# A kapcsolati urlap uzenetei ide erkeznek (uresen: az urlap ki van kapcsolva)
CONTACT_TO=

# A cYc SAJAT rejtett belso feluletenek utvonala (valassz nehezen kitalalhatot, pl. x7k2/belso).
# NE egyezzen meg a szerveren mar futo, kulon weboldal utvonalaval! (Az nginx elobb azt szolgalja ki.)
HIDDEN_PATH=x7k2
# Admin panel utvonala
ADMIN_PATH=admin

RATES_CACHE_SECONDS=60
# Opcionalis CoinGecko Demo API kulcs (magasabb limit)
COINGECKO_API_KEY=
# Fejleszteshez: kitalalt arfolyamok internet nelkul
RATES_MOCK=false

# Csak fejleszteshez/teszthez: a /api/dev/outbox vegpont mutatja a "kikuldott" leveleket. ELESBEN SOHA!
# DEV_OUTBOX=false
